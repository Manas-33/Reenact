# Copy this file to .env and fill in your key:
#
#     cp .env.example .env
#
# Then export it before recording (any of these work):
#
#     export $(grep -v '^#' .env | xargs)     # plain shell
#     set -a; source .env; set +a             # bash/zsh
#     # or use direnv / your tool of choice
#
# Only the one-time recording script (core/examples/record_weather.py) reads
# this. The offline test suite never needs a key.

ANTHROPIC_API_KEY=
